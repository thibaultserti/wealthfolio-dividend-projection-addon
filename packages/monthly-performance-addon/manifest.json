{
  "id": "monthly-performance",
  "name": "Monthly Performance",
  "version": "1.0.0",
  "description": "Monthly and annual investment returns matrix, return distribution bar chart, and benchmark comparison (Alpha)",
  "author": "thibaultserti",
  "main": "dist/addon.js",
  "sdkVersion": "3.7.0",
  "minWealthfolioVersion": "3.6.3",
  "enabled": true,
  "contributes": {
    "routes": [
      {
        "id": "monthly-performance"
      }
    ],
    "links": {
      "sidebar": [
        {
          "id": "monthly-performance",
          "route": "monthly-performance",
          "label": "Monthly Performance",
          "icon": "calendar",
          "order": 47
        }
      ]
    }
  },
  "hostDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@wealthfolio/addon-sdk": "^3.7.0",
    "@wealthfolio/ui": "^3.7.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0"
  },
  "permissions": [
    {
      "category": "performance",
      "purpose": "Calculate cumulative time-weighted returns and monthly performance breakdown across portfolios and benchmarks",
      "functions": [
        {
          "name": "calculateHistory",
          "isDeclared": true,
          "isDetected": true
        },
        {
          "name": "calculateSummary",
          "isDeclared": true,
          "isDetected": true
        }
      ]
    },
    {
      "category": "portfolio",
      "purpose": "Access historical valuations across accounts",
      "functions": [
        {
          "name": "getHistoricalValuations",
          "isDeclared": true,
          "isDetected": true
        }
      ]
    },
    {
      "category": "accounts",
      "purpose": "Filter and display monthly returns by portfolio or specific account",
      "functions": [
        {
          "name": "getAll",
          "isDeclared": true,
          "isDetected": true
        }
      ]
    },
    {
      "category": "market-data",
      "purpose": "Search and fetch benchmark symbol price performance history for alpha comparison",
      "functions": [
        {
          "name": "searchTicker",
          "isDeclared": true,
          "isDetected": true
        }
      ]
    },
    {
      "category": "settings",
      "purpose": "Get user display preferences and base currency settings",
      "functions": [
        {
          "name": "get",
          "isDeclared": true,
          "isDetected": true
        }
      ]
    }
  ],
  "keywords": [
    "wealthfolio",
    "addon",
    "performance",
    "monthly",
    "matrix",
    "returns",
    "alpha",
    "benchmark"
  ],
  "license": "MIT"
}
